# Application URLs
# Frontend URL (Vite dev server)
BASE_URL=http://localhost:5173
# Backend API URL (Express server)
API_URL=http://localhost:4000

# Browser settings
# BROWSER: chrome | firefox | edge
BROWSER=chrome
# HEADLESS=false → visible browser window; HEADLESS=true → no window (CI/CD)
HEADLESS=false
# Global JS/explicit-wait timeout (ms). Keep at 10 000 for CI; raise locally when debugging.
TIMEOUT=10000
# Selenium implicit wait. 1 000 ms is the sweet spot: fails fast on missing elements.
IMPLICIT_WAIT=1000
PAGE_LOAD_TIMEOUT=20000
# SLOW_MOTION_MS: pause (ms) between every UI action. 0 = no pause (default).
# Set to 500-1500 during demos to make automation visible and easy to follow.
SLOW_MOTION_MS=0

# E2E Super Admin — used by the full business-workflow smoke test
SUPER_ADMIN_EMAIL=your.superadmin@mail.com
SUPER_ADMIN_PASSWORD=YourPassword@123

# Test credentials — Global Super Admin
GSA_EMAIL=gsa@estimation.local
GSA_PASSWORD=GSA@Secure2026!

# Test credentials — Scoped Super Admin
SSA_EMAIL=ssa@estimation.local
SSA_PASSWORD=SSA@Secure2026!

# Test credentials — Admin
ADMIN_EMAIL=admin@estimation.local
ADMIN_PASSWORD=Admin@Secure2026!

# Test credentials — Normal User
USER_EMAIL=user@estimation.local
USER_PASSWORD=User@Secure2026!

# Test credentials — Inactive User (for negative login tests)
INACTIVE_EMAIL=inactive@estimation.local
INACTIVE_PASSWORD=Inactive@Secure2026!
