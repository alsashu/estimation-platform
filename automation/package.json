{
  "name": "estimation-platform-automation",
  "version": "1.0.0",
  "description": "Selenium automation suite for Estimation Platform",
  "main": "index.js",
  "scripts": {
    "seed": "node scripts/seedTestUsers.js",
    "test": "mocha --config .mocharc.cjs",
    "test:auth": "mocha --config .mocharc.cjs 'tests/authentication/**/*.test.js'",
    "test:users": "mocha --config .mocharc.cjs 'tests/users/**/*.test.js'",
    "test:projects": "mocha --config .mocharc.cjs 'tests/projects/**/*.test.js'",
    "test:rbac": "mocha --config .mocharc.cjs 'tests/rbac/**/*.test.js'",
    "test:dashboard": "mocha --config .mocharc.cjs 'tests/dashboard/**/*.test.js'",
    "test:storypoint": "mocha --config .mocharc.cjs 'tests/storypoint/**/*.test.js'",
    "test:parametric": "mocha --config .mocharc.cjs 'tests/parametric/**/*.test.js'",
    "test:historical": "mocha --config .mocharc.cjs 'tests/historical/**/*.test.js'",
    "test:analytics": "mocha --config .mocharc.cjs 'tests/analytics/**/*.test.js'",
    "test:masterdata": "mocha --config .mocharc.cjs 'tests/masterdata/**/*.test.js'",
    "test:competency": "mocha --config .mocharc.cjs 'tests/competency/**/*.test.js'",
    "test:notifications": "mocha --config .mocharc.cjs 'tests/notifications/**/*.test.js'",
    "test:registration": "mocha --config .mocharc.cjs 'tests/registration/**/*.test.js'",
    "test:security": "mocha --config .mocharc.cjs 'tests/security/**/*.test.js'",
    "test:regression": "mocha --config .mocharc.cjs 'tests/regression/**/*.test.js'",
    "test:e2e": "cross-env HEADLESS=false mocha --config .mocharc.cjs 'tests/e2e/**/*.test.js'",
    "test:e2e:ci": "cross-env HEADLESS=true mocha --config .mocharc.cjs 'tests/e2e/**/*.test.js'",
    "test:smoke": "cross-env HEADLESS=false mocha --config .mocharc.smoke.cjs",
    "test:smoke:ci": "cross-env HEADLESS=true mocha --config .mocharc.smoke.cjs",
    "test:parallel": "cross-env HEADLESS=false mocha --config .mocharc.parallel.cjs",
    "test:parallel:ci": "cross-env HEADLESS=true mocha --config .mocharc.parallel.cjs",
    "test:full": "cross-env HEADLESS=false mocha --config .mocharc.parallel.cjs",
    "test:chrome": "cross-env BROWSER=chrome mocha --config .mocharc.cjs",
    "test:firefox": "cross-env BROWSER=firefox mocha --config .mocharc.cjs",
    "test:edge": "cross-env BROWSER=edge mocha --config .mocharc.cjs",
    "test:headed": "cross-env HEADLESS=false mocha --config .mocharc.cjs",
    "test:headless": "cross-env HEADLESS=true mocha --config .mocharc.cjs",
    "test:ci": "cross-env HEADLESS=true BROWSER=chrome mocha --config .mocharc.parallel.cjs",
    "test:demo": "cross-env HEADLESS=false SLOW_MOTION_MS=800 mocha --config .mocharc.cjs",
    "test:demo:auth": "cross-env HEADLESS=false SLOW_MOTION_MS=800 mocha --config .mocharc.cjs 'tests/authentication/**/*.test.js'",
    "report:allure": "allure generate allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:generate": "allure generate allure-results --clean -o reports/allure-report",
    "dashboard": "node utils/DashboardGenerator.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "clean": "rimraf allure-results reports/allure-report screenshots logs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "selenium-webdriver": "^4.21.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "allure-commandline": "^2.29.0",
    "allure-mocha": "^3.0.6",
    "allure-js-commons": "^3.0.6",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.2",
    "chromedriver": "^125.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "geckodriver": "^4.4.2",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "rimraf": "^5.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
